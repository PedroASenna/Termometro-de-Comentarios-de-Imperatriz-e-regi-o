# Copie este arquivo para ".env" (na raiz do projeto) e ajuste os valores.
# `cp .env.example .env`   (Linux/macOS)
# `copy .env.example .env` (Windows)

# ---------------------------------------------------------------------------
# Banco de dados (lido por backend/database.py)
# ---------------------------------------------------------------------------
# SQLite (padrão, não requer nenhum servidor instalado):
DATABASE_URL=sqlite:///./termometro_ma.db

# Exemplo para PostgreSQL em produção (requer psycopg2-binary instalado):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/termometro

# ---------------------------------------------------------------------------
# Credenciais opcionais para os coletores experimentais em src/
# (usados apenas por src/auth.py + src/collectors/*, não pelo backend/
# principal). Deixe em branco se você não for usar esses coletores.
# ---------------------------------------------------------------------------
API_KEY=
API_SECRET=
ACCESS_TOKEN=
ACCESS_TOKEN_SECRET=
BEARER_TOKEN=
